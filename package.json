{
  "name": "numo-web",
  "version": "0.1.0",
  "description": "NuMo web app (Next.js + TypeScript)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "oxlint --type-aware --deny-warnings src/ .github/scripts/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p .github/scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "postinstall": "husky"
  },
  "engines": {
    "node": ">=26"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --type-aware --deny-warnings --no-error-on-unmatched-pattern --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "dependencies": {
    "@expo/html-elements": "0.10.1",
    "@gluestack-ui/core": "3.0.25",
    "@gluestack-ui/utils": "3.0.21",
    "@gluestack/ui-next-adapter": "3.0.3",
    "@legendapp/motion": "2.5.3",
    "dom-helpers": "5.2.1",
    "nativewind": "4.2.7",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-aria": "3.53.1",
    "react-dom": "^19.3.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-svg": "15.16.1",
    "react-native-web": "0.21.4",
    "react-stately": "3.51.0",
    "tailwind-variants": "0.1.20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@react-native/assets-registry": "0.79.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-native": "0.72.8",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "10.6.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "postcss": "8.5.32",
    "prettier": "^3.10.1",
    "tailwindcss": "3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
