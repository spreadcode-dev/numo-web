# Copy to `.env.local` to override. Read by the Next.js server only (no
# NEXT_PUBLIC_ prefix), so it never reaches the browser.

# numo-api base URL: the server calls it (Server Actions).
NUMO_API_URL=http://localhost:3000

# Required. Encrypts the session cookie: at least 32 random bytes, never
# committed. Generate one with: openssl rand -base64 48
SESSION_SECRET=
